{% if is_tee %}
{% assign gallery_files = 'front,back,detail' | split: ',' %}
<div class="main-product-image" data-main-image><img src="{{ 'club-' | append: color | append: '-front-cutout-800.webp' | asset_url }}" alt="{{ product.title | escape }} concept, front" width="1254" height="1254"></div>
<div class="product-thumbnails" role="group" aria-label="Product images">
{% for view in gallery_files %}{% assign image_file = 'club-' | append: color | append: '-' | append: view | append: '-cutout-' %}{% if view == 'detail' %}{% assign image_file = image_file | append: '480.webp' %}{% else %}{% assign image_file = image_file | append: '800.webp' %}{% endif %}
<button type="button" data-image-url="{{ image_file | asset_url }}" data-image-alt="{{ product.title | escape }}, {{ view }}" aria-label="View {{ view }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ image_file | asset_url }}" alt="{{ view }}" width="160" height="160" loading="lazy"></button>{% endfor %}{% if color == 'black' %}{% render 'front-detail-thumbnail' %}{% endif %}</div>
<noscript>{% for view in gallery_files offset: 1 %}{% assign image_file = 'club-' | append: color | append: '-' | append: view | append: '-cutout-480.webp' %}<img src="{{ image_file | asset_url }}" alt="{{ product.title | escape }}, {{ view }}" width="800" height="800" loading="lazy">{% endfor %}{% if color == 'black' %}<img src="{{ 'club-black-front-detail-cutout-800.webp' | asset_url }}" alt="Black Survival Club tee, chest logo close-up" width="800" height="800" loading="lazy">{% endif %}</noscript>
{% else %}<div class="main-product-image" data-main-image><img src="{{ 'product-woven-1100.webp' | asset_url }}" alt="P001 Sport Band concept" width="1672" height="941"></div>{% endif %}
