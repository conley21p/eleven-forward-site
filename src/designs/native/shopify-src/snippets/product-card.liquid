{% assign is_tee_card = false %}{% assign card_color = 'black' %}
{% if card_product.id == settings.black_tee_product.id and card_product != blank or fallback_handle == 'survival-club-tee-black' %}{% assign is_tee_card = true %}{% endif %}
{% if card_product.id == settings.white_tee_product.id and card_product != blank or fallback_handle == 'survival-club-tee-white' %}{% assign is_tee_card = true %}{% assign card_color = 'white' %}{% endif %}
{% assign card_back = card_product.images[1] %}
{% assign show_back = false %}{% if is_tee_card %}{% if card_back != blank or card_product.featured_image == blank %}{% assign show_back = true %}{% endif %}{% endif %}
{% assign card_ready = false %}{% if settings.enable_purchasing and card_product.metafields.custom.commerce_ready.value == true %}{% assign card_ready = true %}{% endif %}
<article class="product-card"><a class="product-card-media" tabindex="-1" aria-hidden="true" href="{% if card_product != blank %}{{ card_product.url }}{% else %}{{ routes.root_url }}products/{{ fallback_handle }}{% endif %}">
<div class="product-card-image{% if show_back %} has-back-view{% endif %}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,1000' }}{% elsif fallback_image %}<img src="{{ fallback_image | asset_url }}" alt="{{ fallback_title | escape }}" width="800" height="800" loading="lazy">{% endif %}
{% if show_back %}<div class="product-card-back" aria-hidden="true">{% if card_back != blank %}{{ card_back | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,1000' }}{% else %}<img src="{{ 'club-' | append: card_color | append: '-back-cutout-800.webp' | asset_url }}" alt="" width="1254" height="1254" loading="lazy">{% endif %}</div>{% endif %}</div>
</a><div class="product-card-info"><a class="product-card-title" href="{% if card_product != blank %}{{ card_product.url }}{% else %}{{ routes.root_url }}products/{{ fallback_handle }}{% endif %}"><h2>{{ card_product.title | default: fallback_title | escape }}</h2></a>
{% if show_catalog_purchase %}{% render 'quick-shop', quick_product: card_product, quick_color: card_color, quick_tee: is_tee_card, quick_ready: card_ready, quick_handle: fallback_handle %}{% else %}
{% if card_ready %}<p>{% if card_product.price_varies %}From {% endif %}{{ card_product.price | money_with_currency }}{% unless card_product.available %}<span class="availability">Sold out</span>{% endunless %}</p>{% else %}<p>Price to be announced<span class="availability">Coming soon</span></p>{% endif %}{% endif %}</div></article>
