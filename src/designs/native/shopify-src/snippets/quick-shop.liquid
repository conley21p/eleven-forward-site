{% assign quick_url = quick_product.url %}{% if quick_url == blank %}{% assign quick_url = routes.root_url | append: 'products/' | append: quick_handle %}{% endif %}
{% assign quick_uid = section.id | append: '-' | append: quick_handle %}
<ef-quick-shop class="quick-shop">
<p class="quick-card-price">{% if quick_ready %}{% if quick_product.price_varies %}From {% endif %}{{ quick_product.price | money_with_currency }}{% else %}Price to be announced{% endif %}</p>
<div class="quick-card-actions"><a class="submit button-secondary" href="{{ quick_url }}">View</a>
{% if quick_ready and quick_product.available %}<a class="submit" href="{{ quick_url }}" data-quick-open aria-haspopup="dialog" aria-controls="QuickShop-{{ quick_uid }}">Add to cart</a>{% else %}<button class="submit" type="button" disabled>{% if quick_ready %}Sold out{% else %}Coming soon{% endif %}</button>{% endif %}</div>
{% if settings.enable_purchasing == false and settings.enable_newsletter %}
<a class="text-link" href="#updates-footer">Join the newsletter <span class="arrow" aria-hidden="true">↓</span></a>
{% endif %}
{% if quick_ready and quick_product.available %}
<dialog class="quick-dialog" id="QuickShop-{{ quick_uid }}" aria-labelledby="QuickTitle-{{ quick_uid }}">
<div class="quick-dialog-header"><p class="eyebrow">Eleven Forward / Quick shop</p><button type="button" class="quick-close button-secondary" data-quick-close aria-label="Close quick shop">×</button></div>
<div class="quick-dialog-layout" data-product-detail>
{% render 'product-gallery', product: quick_product, is_tee: quick_tee, color: quick_color %}
<div class="quick-dialog-copy"><h2 id="QuickTitle-{{ quick_uid }}">{{ quick_product.title | escape }}</h2>{% if quick_tee %}<p class="quick-fit-note">{{ quick_color | capitalize }} · Unisex</p>{% endif %}
<div class="quick-options">
<div class="toggle-group quick-gender" role="group" aria-label="{% if quick_tee %}Unisex sizing guidance{% else %}Fit{% endif %}"><button type="button" data-quick-gender="men" aria-pressed="true">Men’s</button><button type="button" data-quick-gender="women" aria-pressed="false">Women’s</button></div>
{% assign quick_picker_instance = quick_handle | append: '-quick' %}{% render 'product-picker', picker_product: quick_product, picker_mode: 'quick', picker_color: quick_color, is_tee: quick_tee, hide_tee_guidance: true, picker_instance: quick_picker_instance %}
<p class="purchase-note">Shipping and applicable taxes calculated at checkout.</p></div>
<a class="quick-full-details" href="{{ quick_url }}">Full product details ↗</a></div></div>
</dialog>{% endif %}</ef-quick-shop>
