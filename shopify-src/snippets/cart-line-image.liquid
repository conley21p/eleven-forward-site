{% assign line_image = item.image | default: item.product.featured_image %}
{% if item.product.handle == 'survival-club-tee-black' or item.product.id == settings.black_tee_product.id %}
  <img src="{{ 'club-black-front-cutout-800.webp' | asset_url }}" width="360" height="360" loading="lazy" alt="">
{% elsif item.product.handle == 'survival-club-tee-white' or item.product.id == settings.white_tee_product.id %}
  <img src="{{ 'club-white-front-cutout-800.webp' | asset_url }}" width="360" height="360" loading="lazy" alt="">
{% elsif line_image %}
  {{ line_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '' }}
{% elsif item.product.id == settings.band_product.id %}
  <img src="{{ 'product-woven-1100.webp' | asset_url }}" width="360" height="360" loading="lazy" alt="">
{% endif %}
