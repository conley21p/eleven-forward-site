{% assign line_image = item.image | default: item.product.featured_image %}
{% if line_image %}
{{ line_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '' }}
{% else %}
{% assign fallback_image = blank %}
{% if item.product.id == settings.band_product.id %}{% assign fallback_image = 'product-woven-1100.webp' %}
{% elsif item.product.id == settings.black_tee_product.id %}{% assign fallback_image = 'club-black-front-cutout-800.webp' %}
{% elsif item.product.id == settings.white_tee_product.id %}{% assign fallback_image = 'club-white-front-cutout-800.webp' %}{% endif %}
{% if fallback_image != blank %}<img src="{{ fallback_image | asset_url }}" width="360" height="360" loading="lazy" alt="">{% endif %}
{% endif %}
