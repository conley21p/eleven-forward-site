<div class="product-media">{% if product.images.size > 0 %}<div class="main-product-image" data-main-image>
{% if product.featured_image %}{{ product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '480,800,1200,1800' }}{% else %}<p>Product photography coming soon.</p>{% endif %}
</div><div class="product-thumbnails" role="group" aria-label="Product images">
{% for image in product.images %}<button type="button" data-image-url="{{ image | image_url: width: 1800 }}" data-image-alt="{{ image.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy' }}</button>{% endfor %}{% if is_tee and color == 'black' %}{% render 'front-detail-thumbnail' %}{% endif %}</div>
<noscript><div class="static-product-gallery">{% for image in product.images offset: 1 %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% endfor %}{% if is_tee and color == 'black' %}<img src="{{ 'club-black-front-detail-cutout-800.webp' | asset_url }}" alt="Black Survival Club tee, chest logo close-up" width="800" height="800" loading="lazy">{% endif %}</div></noscript>{% else %}{% render 'fallback-product-media', is_tee: is_tee, color: color %}{% endif %}</div>
